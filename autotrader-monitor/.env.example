# HTTP/WebSocket server
PORT=3001
NODE_ENV=development

# NATS JetStream
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=TRADE_EVENTS
NATS_SUBJECT_FILTER=trade.>
NATS_DURABLE_NAME=autotrader-monitor-v2
NATS_CREATE_STREAM_IF_MISSING=true
NATS_LAG_POLL_INTERVAL_MS=5000

# Dashboard
DASHBOARD_RECENT_LIMIT=20
DASHBOARD_WARNING_LIMIT=20

# Redis cache
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=autotrader:monitor
REDIS_CACHE_TTL_SECONDS=86400

# Slack alerts
SLACK_ALERT_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_MIN_LEVEL=warning
SLACK_NOTIFY_ORDER_ACCEPTED=false
SLACK_NOTIFY_ORDER_SKIPPED=false

# Prometheus metrics
METRICS_ENABLED=true
METRICS_DEFAULTS_ENABLED=true
